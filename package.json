{
  "name": "zui-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^24.0.0",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "dev": "pnpm --filter @zui/core build && pnpm --filter @zui/docs dev",
    "build": "pnpm -r build",
    "preview": "pnpm --filter @zui/docs preview",
    "check": "pnpm -r check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm --filter @zui/docs test",
    "changeset": "changeset",
    "generate": "node scripts/generate-css.mjs",
    "generate:check": "node scripts/generate-css.mjs --check",
    "contracts:check": "node scripts/verify-contracts.mjs",
    "contracts:update": "node scripts/verify-contracts.mjs --update",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "test:core": "pnpm --filter @zui/core run test",
    "test:core:browser": "pnpm --filter @zui/core run test:browser",
    "test:packages": "node scripts/verify-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-svelte": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
