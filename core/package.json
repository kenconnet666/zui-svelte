{
  "name": "@zui/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Framework-independent runtime styling foundation for ZUI.",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "zui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../scripts/build-core.mjs",
    "check": "node ../scripts/measure-types.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "clsx": "catalog:",
    "csstype": "catalog:",
    "stylis": "catalog:"
  },
  "devDependencies": {
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "@types/stylis": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
