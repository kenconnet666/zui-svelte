{
  "name": "@zui/svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte components and reactive styling integration for ZUI.",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./compiler": {
      "zui-source": "./src/compiler/preprocess.ts",
      "types": "./dist/compiler/preprocess.d.ts",
      "default": "./dist/compiler/preprocess.js"
    },
    "./internal": {
      "zui-source": "./src/runtime/scope.ts",
      "types": "./dist/runtime/scope.d.ts",
      "default": "./dist/runtime/scope.js"
    },
    "./server": {
      "zui-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    ".": {
      "zui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "svelte-package --input src",
    "check": "svelte-check --tsconfig ./tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "typescript": "catalog:",
    "magic-string": "catalog:",
    "@zui/core": "workspace:^",
    "@lucide/svelte": "catalog:"
  },
  "peerDependencies": {
    "svelte": "^5.57.0"
  },
  "devDependencies": {
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  }
}
