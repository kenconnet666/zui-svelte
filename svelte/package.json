{
  "name": "@zui/svelte",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Svelte components and reactive styling integration for ZUI.",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "**/*.css",
    "./src/validation.ts",
    "./dist/validation.js"
  ],
  "exports": {
    "./compiler": {
      "zui-source": "./src/compiler/preprocess.ts",
      "types": "./dist/compiler/preprocess.d.ts",
      "default": "./dist/compiler/preprocess.js"
    },
    "./internal": {
      "zui-source": "./src/internal.ts",
      "types": "./dist/internal.d.ts",
      "default": "./dist/internal.js"
    },
    "./server": {
      "zui-source": "./src/server.ts",
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    ".": {
      "zui-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "build:code": "node build.mjs --no-types",
    "check": "svelte-check --tsconfig ./tsconfig.check.json",
    "test": "vitest run",
    "test:dev": "playwright test --config playwright.dev.config.ts",
    "test:kit:prepare": "pnpm --dir tests/kit install --ignore-workspace --ignore-scripts --no-lockfile && cd tests/kit && node ../../node_modules/@sveltejs/kit/svelte-kit.js sync",
    "test:kit:build": "cd tests/kit && vite build",
    "test:kit": "playwright test"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@internationalized/date": "catalog:",
    "@lucide/svelte": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "@zui/core": "workspace:^",
    "decimal.js": "catalog:",
    "focus-trap": "catalog:",
    "magic-string": "catalog:",
    "tabbable": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.70.3",
    "svelte": "^5.57.0"
  },
  "peerDependenciesMeta": {
    "@sveltejs/kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@sveltejs/adapter-node": "catalog:",
    "@sveltejs/adapter-static": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@sveltejs/package": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-svelte": "catalog:"
  }
}
